# ==============================================================================
# UpdatePilot — Environment Configuration Template
# Copy this file to .env or configure in your Cloud Hosting Provider (Railway/Render)
# ==============================================================================

# Server Network Configuration
PORT=4000
NODE_ENV=production

# ------------------------------------------------------------------------------
# Database Connection URL
# ------------------------------------------------------------------------------
# Option A: Local Development / Persistent VM (SQLite)
DATABASE_URL="file:./apps/backend/prisma/dev.db"

# Option B: Cloud Hosting (Railway PostgreSQL)
# Railway automatically populates DATABASE_URL when PostgreSQL plugin is attached:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/railway"

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# Mandatory in production: generate a 32+ character random secret
JWT_SECRET="replace_with_secure_random_jwt_secret_in_production"

# Production Initial Administrator Account (Optional - creates first admin safely)
ADMIN_INITIAL_EMAIL="admin@yourdomain.com"
ADMIN_INITIAL_PASSWORD="ReplaceWithStrongPassword2026!"

# Web dashboard origin for CORS (allowed origins: comma-separated or *)
CORS_ORIGIN="http://localhost:3000,http://localhost:4000"

# Optional fallback pairing secret for automated agent testing
PAIRING_SECRET="updatepilot_pair_token_default_12345"

# ------------------------------------------------------------------------------
# External Intelligence APIs
# ------------------------------------------------------------------------------
# Open Source Vulnerabilities (OSV) query API endpoint
OSV_API_URL="https://api.osv.dev/v1/query"

# Logging Level (debug, info, warn, error)
LOG_LEVEL="info"

# Static Web UI Directory (used by Express to serve Next.js static export)
# In Docker/Production:
STATIC_WEB_DIR="./apps/web/out"
